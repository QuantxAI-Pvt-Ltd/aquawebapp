FROM node:20-bookworm-slim

WORKDIR /app

# Install Python, pip, and system dependencies for OpenCV/PaddleOCR
RUN apt-get update && \
    apt-get install -y python3 python3-pip python3-venv libgl1 libglib2.0-0 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create a virtual environment and install PaddleOCR and PaddlePaddle
# Using a venv avoids the EXTERNALLY-MANAGED error on Bookworm
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install paddlepaddle and paddleocr
RUN pip install --no-cache-dir paddlepaddle paddleocr

# Copy package files and install Node dependencies
COPY package*.json ./
RUN npm ci --only=production

# Copy remaining source code
COPY . .

# Expose backend port
EXPOSE 5001

# Start the server
CMD ["npm", "start"]