# AquaInsure Backend Environment Variables Template
PORT=5001
MONGODB_URI=mongodb://localhost:27017/aquainsure
JWT_SECRET=aquainsure-super-secret-jwt-key-2024
JWT_EXPIRES_IN=30d

# CORS Allowed Origins (comma-delimited)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost

# Request & Upload Limits
BODY_PARSER_LIMIT=50mb
MAX_FILE_SIZE_MB=10

# SeaweedFS / S3 Object Storage Configuration
SEAWEEDFS_S3_ENDPOINT=http://localhost:8333
SEAWEEDFS_FILER_ENDPOINT=http://localhost:8888
SEAWEEDFS_BUCKET=aquainsure-media
SEAWEEDFS_ACCESS_KEY=any_key
SEAWEEDFS_SECRET_KEY=any_secret
SEAWEEDFS_REGION=us-east-1
