# AquaInsure (Farmer Mobile App) Environment Variables Template

# Backend API Endpoint
# Standalone local dev: http://localhost:5001
# Behind Apache reverse proxy (or production): leave blank or set to /api
NEXT_PUBLIC_API_URL=http://localhost:5001

# Admin & Insurer Web Dashboard URL
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# Next.js Allowed Development Origins (comma-separated IP addresses or domains)
ALLOWED_DEV_ORIGINS=10.47.51.139,10.63.178.139,localhost
