FROM node:20-alpine AS builder

WORKDIR /app

# Copy monorepo configuration and packages
COPY package.json package-lock.json turbo.json ./
COPY packages/ ./packages/
COPY apps/AquaInsure/ ./apps/AquaInsure/

# Install dependencies and build static output
RUN npm install
ENV NODE_ENV=production
RUN npm --prefix apps/AquaInsure run build

# Production runner stage
FROM node:20-alpine AS runner
WORKDIR /app

RUN npm install express@4

COPY --from=builder /app/apps/AquaInsure/dist ./dist
COPY --from=builder /app/apps/AquaInsure/server.cjs ./server.cjs

EXPOSE 8080
ENV PORT=8080

CMD ["node", "server.cjs"]