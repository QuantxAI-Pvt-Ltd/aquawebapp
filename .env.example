# ==============================================================================
# AQUAINSURE PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# ─── 1. HOST PORT BINDINGS ────────────────────────────────────────────────────
PROXY_PORT=80
FARMER_PORT=8080
DASHBOARD_PORT=3000
BACKEND_PORT=5001
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
SEAWEED_S3_PORT=8333
SEAWEED_FILER_PORT=8888
SEAWEED_MASTER_PORT=9333
SEAWEED_VOLUME_PORT=8085

# ─── 2. GENERAL SETTINGS ──────────────────────────────────────────────────────
NODE_ENV=production
CORS_ALLOWED_ORIGINS=*
BACKEND_PUBLIC_URL=http://localhost:5001
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_BASE_PATH=/dashboard

# ─── 3. SECURITY & AUTHENTICATION ─────────────────────────────────────────────
JWT_SECRET=aquainsure-super-secret-jwt-key-2024
JWT_EXPIRES_IN=30d

# ─── 4. MONGODB DATABASE CONFIGURATION ────────────────────────────────────────
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=AquaInsureRootSecret2026!
MONGO_APP_USERNAME=aquainsure_app
MONGO_APP_PASSWORD=AquaInsureAppSecret2026!
MONGO_DATABASE=aquainsure

# ─── 5. SEAWEEDFS DISTRIBUTED OBJECT STORAGE ──────────────────────────────────
SEAWEEDFS_BUCKET=aquainsure
SEAWEEDFS_VOLUME_MAX=100

# ─── 6. MONGO EXPRESS WEB GUI CREDENTIALS ────────────────────────────────────
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=aquainsure
