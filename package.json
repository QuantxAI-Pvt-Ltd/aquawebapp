{
  "name": "aquainsure",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "eslint-config-next": "16.2.4",
    "next": "16.2.4",
    "prettier": "3.9.6",
    "turbo": "^2.10.13",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.9.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
